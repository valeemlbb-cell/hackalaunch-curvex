# CurveX configuration. Copy to `.env` and fill in locally.
# NOTHING SECRET BELONGS IN THIS FILE OR IN THIS REPOSITORY.
# `.gitignore` blocks `.env`, `*keypair*.json` and every local ledger directory.

# --- network -----------------------------------------------------------------
# Devnet only. Do not point this at mainnet-beta: CurveX is a hackathon entry
# and has not been audited.
CURVEX_RPC_URL=https://api.devnet.solana.com

# --- signing -----------------------------------------------------------------
# Path to a Solana keypair JSON file that lives OUTSIDE this repository.
# The CLI reads it at run time; it is never copied, logged or committed.
# Default if unset: ~/.config/solana/id.json
CURVEX_KEYPAIR=/absolute/path/outside/this/repo/id.json

# --- local test validator (only used by `npm test`) --------------------------
# Override if 8899 is busy; the faucet port defaults to CURVEX_RPC_PORT + 1001.
CURVEX_RPC_PORT=8899
CURVEX_FAUCET_PORT=9900
CURVEX_LEDGER_DIR=.test-ledger
# Slot length. 2 ticks/slot (~12 ms) lets slot-measured behaviour run in
# seconds; raise it toward 64 for mainnet-like timing.
CURVEX_TICKS_PER_SLOT=2
# Absolute path to solana-test-validator if it is not on PATH.
SOLANA_TEST_VALIDATOR=solana-test-validator

# `npm test` sets CURVEX_FAUCET_KEYPAIR itself, pointing at the throwaway
# keypair the local validator generates inside its own ledger directory.
